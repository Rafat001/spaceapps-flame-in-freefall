# ---- Flame in Freefall configuration (copy to .env; never commit .env) ----

# LLM used by /api/ask:  groq (free plan, recommended) | gemini (free tier) | local (Ollama, free) | openai | anthropic | none (computed answers only)
# Users can also paste their own key in Settings (kept in their browser tab only; see README "Bring your own key").
AI_LLM_PROVIDER=local
# Embeddings for vector search: local (sentence-transformers, free) | openai | hash (offline fallback, no download)
AI_EMBEDDING_PROVIDER=local

# Local / free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Groq free plan (recommended free hosted option). Key: https://console.groq.com/keys
# GROQ_MODEL must be a free-plan production model: openai/gpt-oss-120b (default) | openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini API Free tier. Key: https://aistudio.google.com/apikey
# GEMINI_MODEL must be a free-tier text model: gemini-3.8-flash (default) | gemini-3.5-flash-lite
# (https://ai.google.dev/gemini-api/docs/pricing, checked 2026-11-14). Leave blank if unused.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Limits on POST /api/ask when it uses the shared server key (your own key in Settings is not counted)
ASK_RATE_PER_MIN=10
ASK_RATE_PER_DAY=200
ASK_GLOBAL_PER_MIN=25
ASK_GLOBAL_PER_DAY=900

# Paid (optional) — leave blank if unused
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Admin lock for PUT /api/settings/ai and POST /api/ingest/rebuild (send as X-Admin-Token).
# When unset these are disabled in production (APP_ENV=production or on Render) and open in local development.
ADMIN_TOKEN=
APP_ENV=development

LLM_TIMEOUT_S=60
VECTOR_BACKEND=faiss          # faiss | numpy
# DATABASE_URL=sqlite:///./data/db/flame.sqlite   (default; Postgres URL also works with SQLAlchemy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
